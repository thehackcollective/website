#!/usr/bin/env bash
#USAGE: up — start the dev servers in the background: ./c up [site|work] [mock-data:empty|mock-data:full] [dev-member]

set -euo pipefail

THC_ROOT="${THC_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
export THC_ROOT
cd "$THC_ROOT"
source "$THC_ROOT/scripts/c/_lib/services.sh"
source "$THC_ROOT/scripts/c/_lib/op-environments.sh"

usage() {
  cat <<'HELP'
Usage: ./c up                     start site and work
       ./c up site                hackcollective.uk on :5173
       ./c up work                app.hackcollective.uk (client and Worker) on :5281
       ./c up work mock-data:empty|mock-data:full
                                  reset the local work data first
       ./c up work dev-member     skip the Clerk dev keys and open signed in as the dev member

  ./c up runs under op run --environment with the 1Password dev Environment
  (scripts/c/_lib/op-environments.sh). Secrets live in process.env only: no .env or .dev.vars file.
  The Environment holds the Clerk dev keys, so the work app asks for a sign-in to the
  invite-only Clerk dev instance. With dev-member, it opens signed in as the dev member.
  Logs and pids go to .c-runtime/. ./c status shows the servers. ./c quit stops them.
HELP
}

SERVICES=()
MOCK_DATA=""
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage; exit 0 ;;
    site|work) SERVICES+=("$arg") ;;
    mock-data:empty|mock-data:full) MOCK_DATA="${arg#mock-data:}" ;;
    dev-member) export THC_DEV_MEMBER=1 ;;
    *) echo "✗ $arg is not an argument of ./c up." >&2; usage >&2; exit 2 ;;
  esac
done
(( ${#SERVICES[@]} > 0 )) || SERVICES=(site work)
if [[ -n "$MOCK_DATA" && " ${SERVICES[*]} " != *" work "* ]]; then
  echo "✗ mock-data resets the work data. Run ./c up work mock-data:$MOCK_DATA." >&2
  exit 2
fi

run_under_op_dev "${BASH_SOURCE[0]}" "$@"
refuse_env_files

mkdir -p "$RUNTIME_DIR/logs" "$RUNTIME_DIR/pids"

start_command() {
  case "$1" in
    site) echo "cd '$THC_ROOT' && exec bunx vite --port $SITE_PORT --strictPort" ;;
    work)
      if [[ ! -d "$THC_ROOT/workers/internal/migrations" ]]; then
        echo "cd '$THC_ROOT/internal' && exec bunx vite --port $WORK_PORT --strictPort"
        return 0
      fi
      local db
      db="$(sed -nE "s/.*id: '([0-9a-f-]{36})'.*/\\1/p" "$THC_ROOT/internal/cloudflare.config.ts" | head -1)"
      [[ -n "$db" ]] || { echo "✗ internal/cloudflare.config.ts has no D1 id." >&2; return 1; }
      echo "cd '$THC_ROOT/internal' && CI=1 ../node_modules/.bin/cf d1 migrations apply $db --dir ../workers/internal/migrations --local --persist-to .cloudflare/state && exec bunx vite --port $WORK_PORT --strictPort"
      ;;
  esac
}

start_service() {
  local svc="$1" pid_file log port old command
  pid_file="$RUNTIME_DIR/pids/$svc.pid"
  log="$RUNTIME_DIR/logs/$svc.log"
  port="$(service_port "$svc")"
  if [[ -f "$pid_file" ]]; then
    old="$(cat "$pid_file" 2>/dev/null || true)"
    if [[ -n "$old" ]] && kill -0 "$old" 2>/dev/null; then
      echo "→ $svc is running (PID $old). It stops now and starts again."
      stop_pid_gracefully "$old"
    fi
    rm -f "$pid_file"
  fi
  if ! port_is_free "$port"; then
    echo "✗ Another process holds port $port:" >&2
    lsof -nP -iTCP:"$port" -sTCP:LISTEN >&2 || true
    echo "  ./c up does not stop a process that it did not start. Free the port, then run ./c up $svc again." >&2
    return 1
  fi
  command="$(start_command "$svc")" || return 1
  nohup bash -c "$command" >"$log" 2>&1 &
  echo $! >"$pid_file"
  for _ in $(seq 1 60); do
    if curl -sf -o /dev/null "$(service_url "$svc")"; then
      echo "✓ $svc runs at $(service_url "$svc") (PID $(cat "$pid_file"), log .c-runtime/logs/$svc.log)"
      return 0
    fi
    kill -0 "$(cat "$pid_file")" 2>/dev/null || break
    sleep 1
  done
  echo "✗ $svc did not start. The last log lines:" >&2
  tail -20 "$log" >&2
  return 1
}

if [[ -n "$MOCK_DATA" ]]; then
  if [[ ! -f "$THC_ROOT/scripts/mock-data.ts" ]]; then
    echo "✗ scripts/mock-data.ts is not there. The work app has no mock data yet." >&2
    exit 1
  fi
  bun "$THC_ROOT/scripts/mock-data.ts" "$MOCK_DATA"
  echo "✓ The local work data is now mock-data:$MOCK_DATA."
fi

rc=0
for svc in "${SERVICES[@]}"; do
  start_service "$svc" || rc=1
done
exit "$rc"
