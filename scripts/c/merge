#!/usr/bin/env bash
#USAGE: merge — squash-merge a PR when its head has main and the rules hold: ./c merge <PR>

set -euo pipefail

cd "$THC_ROOT"

fail() { printf '✗ %s\n' "$1" >&2; exit 1; }
say() { printf '→ %s\n' "$1"; }

case "${1:-}" in
  ""|-h|--help)
    echo "Usage: ./c merge <PR>"
    echo "  1. If the head does not have the current main, it merges main into the branch."
    echo "  2. It runs ./c check structure on that head. A loosened rule only warns: list it and its reason in the PR description."
    echo "  3. It squash-merges, pinned to that head, so a push in between stops the merge."
    [[ -n "${1:-}" ]] && exit 0
    exit 2
    ;;
esac

PR="$1"

pr_field() {
  local try
  for try in 1 2 3; do
    gh pr view "$PR" --json "$1" -q ".$1" && return 0
    sleep $((try * 5))
  done
  printf '✗ gh could not read PR #%s three times. Check the network, then run ./c merge %s again.\n' "$PR" "$PR" >&2
  kill -s TERM $$
}

[[ "$(pr_field state)" == "OPEN" ]] || fail "PR #$PR is not open."
[[ "$(pr_field isDraft)" == "false" ]] || fail "PR #$PR is a draft. Mark it ready, then run ./c merge $PR again."
[[ "$(pr_field baseRefName)" == "main" ]] || fail "PR #$PR does not target main. Merge its base first, or retarget it to main."

fetch_head() {
  git fetch -q origin "$HEAD_SHA" 2>/dev/null || git fetch -q origin "refs/pull/$PR/head" 2>/dev/null || true
  git cat-file -e "$HEAD_SHA^{commit}" 2>/dev/null || fail "git could not fetch the head ${HEAD_SHA:0:9} of PR #$PR. Check the network, then run ./c merge $PR again."
}

git fetch -q origin main
HEAD_SHA="$(pr_field headRefOid)"
fetch_head
if ! git merge-base --is-ancestor origin/main "$HEAD_SHA"; then
  say "PR #$PR does not have the current main. Merging main into its branch."
  gh pr update-branch "$PR" >/dev/null || fail "GitHub could not merge main into PR #$PR. Resolve the conflict on the branch, push, then run ./c merge $PR again."
  for _ in $(seq 1 20); do
    NEW_SHA="$(pr_field headRefOid)"
    [[ "$NEW_SHA" != "$HEAD_SHA" ]] && break
    sleep 3
  done
  [[ "$NEW_SHA" != "$HEAD_SHA" ]] || fail "The branch of PR #$PR did not move after the update. Run ./c merge $PR again."
  HEAD_SHA="$NEW_SHA"
fi

git fetch -q origin main
fetch_head
git merge-base --is-ancestor origin/main "$HEAD_SHA" || fail "main moved, so PR #$PR does not have the current main. Run ./c merge $PR again."


CHECK_DIR="$(mktemp -d)"
CHECK_BRANCH="merge-check-$PR-$$-$RANDOM"
CHECK_BRANCH_MADE=0
cleanup() {
  git worktree remove --force "$CHECK_DIR/head" 2>/dev/null || true
  (( CHECK_BRANCH_MADE )) && git branch -q -D "$CHECK_BRANCH" 2>/dev/null || true
  rm -rf "$CHECK_DIR"
}
trap cleanup EXIT
main_still_in_head() {
  git fetch -q origin main
  git merge-base --is-ancestor origin/main "$HEAD_SHA" || fail "main moved during the review, so PR #$PR does not have the current main. Run ./c merge $PR again."
}
main_still_in_head
git worktree add -q -b "$CHECK_BRANCH" "$CHECK_DIR/head" "$HEAD_SHA"
CHECK_BRANCH_MADE=1
ln -s "$THC_ROOT/node_modules" "$CHECK_DIR/head/node_modules"
say "./c check structure on ${HEAD_SHA:0:9}"
(cd "$CHECK_DIR/head" && BASE_RULES_AGAINST=origin/main BASE_RULES_TARGET=pr ./c check structure) \
  || fail "The structure check failed on ${HEAD_SHA:0:9}. Fix it on the branch, then run ./c merge $PR again."
cleanup
trap - EXIT

BRANCH="$(pr_field headRefName)"
CROSS_REPO="$(pr_field isCrossRepository)"
main_still_in_head
gh pr merge "$PR" --squash --match-head-commit "$HEAD_SHA" >/dev/null || fail "GitHub refused the merge of PR #$PR. Read gh pr view $PR, then run ./c merge $PR again."
if [[ "$CROSS_REPO" == "false" ]]; then
  RETARGETED=1
  for child in $(gh pr list --base "$BRANCH" --state open --limit 1000 --json number -q '.[].number'); do
    if gh pr edit "$child" --base main >/dev/null; then
      say "PR #$child now targets main."
      gh pr update-branch "$child" >/dev/null || say "GitHub could not merge main into PR #$child. Resolve the conflict on its branch and push."
    else
      RETARGETED=0
      say "GitHub could not move PR #$child to main. Move it to main, then delete the branch $BRANCH."
    fi
  done
  if (( RETARGETED == 1 )); then
    gh api -X DELETE "repos/{owner}/{repo}/git/refs/heads/$BRANCH" >/dev/null 2>&1 || true
  fi
fi
printf '✓ PR #%s merged (head %s).\n' "$PR" "${HEAD_SHA:0:9}"
