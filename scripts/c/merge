#!/usr/bin/env bash
#USAGE: merge — squash-merge a PR when its head has main, Greptile passes and the rules hold: ./c merge <PR>

set -euo pipefail

cd "$THC_ROOT"
source "$THC_ROOT/scripts/c/_lib/limits.sh"

POLL_SECONDS=30
APPEAR_SECONDS=300
WAIT_MAX_SECONDS=2700

fail() { printf '✗ %s\n' "$1" >&2; exit 1; }
say() { printf '→ %s\n' "$1"; }

case "${1:-}" in
  ""|-h|--help)
    echo "Usage: ./c merge <PR>"
    echo "  1. If the head does not have the current main, it merges main into the branch."
    echo "  2. It waits for Greptile Review on that head, or on the head before clean merges of main. The check must pass, and its score must be at or above greptile-score-min in base.rules.yaml."
    echo "     The score comes from the PR body, and only when Greptile is the body's last editor."
    echo "  3. It runs ./c check structure on that head. A loosened rule, or a change to c, scripts/c, the hooks or a guarded config, needs the rules-approved label, added after the review finished."
    echo "  4. It squash-merges, pinned to that head, so a push in between stops the merge."
    [[ -n "${1:-}" ]] && exit 0
    exit 2
    ;;
esac

PR="$1"

pr_field() {
  local try
  for try in 1 2 3; do
    gh pr view "$PR" --json "$1" -q ".$1" && return 0
    sleep $((try * 5))
  done
  printf '✗ gh could not read PR #%s three times. Check the network, then run ./c merge %s again.\n' "$PR" "$PR" >&2
  kill -s TERM $$
}

[[ "$(pr_field state)" == "OPEN" ]] || fail "PR #$PR is not open."
[[ "$(pr_field isDraft)" == "false" ]] || fail "PR #$PR is a draft. Mark it ready, then run ./c merge $PR again."
[[ "$(pr_field baseRefName)" == "main" ]] || fail "PR #$PR does not target main. Merge its base first, or retarget it to main."

fetch_head() {
  git fetch -q origin "$HEAD_SHA" 2>/dev/null || git fetch -q origin "refs/pull/$PR/head" 2>/dev/null || true
  git cat-file -e "$HEAD_SHA^{commit}" 2>/dev/null || fail "git could not fetch the head ${HEAD_SHA:0:9} of PR #$PR. Check the network, then run ./c merge $PR again."
}

git fetch -q origin main
HEAD_SHA="$(pr_field headRefOid)"
fetch_head
if ! git merge-base --is-ancestor origin/main "$HEAD_SHA"; then
  say "PR #$PR does not have the current main. Merging main into its branch."
  gh pr update-branch "$PR" >/dev/null || fail "GitHub could not merge main into PR #$PR. Resolve the conflict on the branch, push, then run ./c merge $PR again."
  for _ in $(seq 1 20); do
    NEW_SHA="$(pr_field headRefOid)"
    [[ "$NEW_SHA" != "$HEAD_SHA" ]] && break
    sleep 3
  done
  [[ "$NEW_SHA" != "$HEAD_SHA" ]] || fail "The branch of PR #$PR did not move after the update. Run ./c merge $PR again."
  HEAD_SHA="$NEW_SHA"
fi

git fetch -q origin main
fetch_head
git merge-base --is-ancestor origin/main "$HEAD_SHA" || fail "main moved, so PR #$PR does not have the current main. Run ./c merge $PR again."

MIN_SCORE="$(limit greptile-score-min origin/main 2>/dev/null || limit greptile-score-min "$HEAD_SHA")"
REVIEWED_SHA="$HEAD_SHA"
WALK=("$HEAD_SHA")
while parents=($(git rev-list --parents -n 1 "$REVIEWED_SHA")) && (( ${#parents[@]} == 3 )) \
  && git merge-base --is-ancestor "${parents[2]}" origin/main \
  && [[ "$(git merge-tree --write-tree "${parents[1]}" "${parents[2]}" 2>/dev/null)" == "$(git rev-parse "$REVIEWED_SHA^{tree}")" ]]; do
  REVIEWED_SHA="${parents[1]}"
  WALK+=("$REVIEWED_SHA")
done
greptile_run() {
  local sha run
  for sha in "${WALK[@]}"; do
    run="$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs?per_page=100" -q '[.check_runs[] | select(.name == "Greptile Review" and .app.slug == "greptile-apps")] | sort_by(.started_at) | last | select(. != null) | "\(.status) \(.conclusion // "none") \(.completed_at // "none")"')" \
      || fail "gh could not read the checks of ${sha:0:9}. Check the network, then run ./c merge $PR again."
    if [[ -n "$run" ]]; then
      printf '%s %s\n' "$sha" "$run"
      return 0
    fi
  done
}
body_score() {
  local editor body blocks block commit score
  editor="$(gh api graphql -F n="$PR" -F owner='{owner}' -F name='{repo}' -f query='query($owner:String!,$name:String!,$n:Int!){repository(owner:$owner,name:$name){pullRequest(number:$n){editor{login}}}}' -q '.data.repository.pullRequest.editor.login // ""')" \
    || fail "gh could not read who last edited PR #$PR. Check the network, then run ./c merge $PR again."
  [[ "$editor" == greptile-apps* ]] || fail "$editor edited the body of PR #$PR after Greptile wrote its score, so ./c merge cannot trust it. Comment @greptileai to rewrite it, then run ./c merge $PR again."
  body="$(pr_field body | tr -d '\r')"
  blocks="$(grep -c '^<!-- greptile_comment -->$' <<<"$body" || true)"
  (( blocks == 1 )) || fail "The body of PR #$PR has $blocks Greptile sections. Comment @greptileai to rewrite it, then run ./c merge $PR again."
  block="$(sed -n '/^<!-- greptile_comment -->$/,/^<!-- \/greptile_comment -->$/p' <<<"$body")"
  commit="$(grep -oE 'Last reviewed commit: .*/commit/[0-9a-f]{40}' <<<"$block" | grep -oE '[0-9a-f]{40}$' | tail -1 || true)"
  score="$(sed -nE 's|^<!-- greptile_confidence_score:([0-9]+) -->$|\1|p' <<<"$block" | tail -1)"
  [[ " ${WALK[*]} " == *" $commit "* && "$score" =~ ^[0-9]+$ ]] && printf '%s\n' "$score"
}

say "Waiting for Greptile Review on ${HEAD_SHA:0:9}."
WAIT_START=$SECONDS
while :; do
  [[ "$(pr_field headRefOid)" == "$HEAD_SHA" ]] || fail "Someone pushed to PR #$PR during the wait. Run ./c merge $PR again."
  RUN="$(greptile_run)"
  read -r RUN_SHA RUN_STATUS RUN_CONCLUSION RUN_COMPLETED <<<"$RUN" || true
  if [[ -z "$RUN" ]]; then
    (( SECONDS - WAIT_START < APPEAR_SECONDS )) || fail "Greptile started no review of ${HEAD_SHA:0:9} in $((APPEAR_SECONDS / 60)) minutes. Comment @greptileai on PR #$PR, then run ./c merge $PR again."
  elif [[ "$RUN_STATUS" == completed ]]; then
    if [[ "$RUN_CONCLUSION" == success ]]; then
      SCORE="$(body_score)"
      [[ "$SCORE" =~ ^[0-9]+$ ]] && break
      (( SECONDS - WAIT_START < WAIT_MAX_SECONDS )) || fail "Greptile wrote no score for ${HEAD_SHA:0:9} in the body of PR #$PR. Run ./c merge $PR again."
      sleep "$POLL_SECONDS"
      continue
    fi
    fail "Greptile Review ended as $RUN_CONCLUSION on ${RUN_SHA:0:9}. Fix each finding or answer it on its thread, push once, then run ./c merge $PR again."
  else
    (( SECONDS - WAIT_START < WAIT_MAX_SECONDS )) || fail "Greptile Review did not finish on ${RUN_SHA:0:9} in $((WAIT_MAX_SECONDS / 60)) minutes. Run ./c merge $PR again."
  fi
  sleep "$POLL_SECONDS"
done
(( SCORE >= MIN_SCORE )) || fail "Greptile scores PR #$PR at $SCORE/5, under $MIN_SCORE. Fix each finding or answer it on its thread, push once, then run ./c merge $PR again."

TARGET=main
LAST_LABEL="$(gh api "repos/{owner}/{repo}/issues/$PR/events" --paginate -q '.[] | select(.label.name == "rules-approved") | "\(.event) \(.created_at)"' | tail -n 1)"
[[ "$LAST_LABEL" == "labeled "* && "${LAST_LABEL#labeled }" > "$RUN_COMPLETED" ]] && TARGET=pr

CHECK_DIR="$(mktemp -d)"
CHECK_BRANCH="merge-check-$PR-$$-$RANDOM"
CHECK_BRANCH_MADE=0
cleanup() {
  git worktree remove --force "$CHECK_DIR/head" 2>/dev/null || true
  (( CHECK_BRANCH_MADE )) && git branch -q -D "$CHECK_BRANCH" 2>/dev/null || true
  rm -rf "$CHECK_DIR"
}
trap cleanup EXIT
guarded() {
  git show "$1:base.rules.yaml" | python3 -c '
import sys, yaml
for paths in (yaml.safe_load(sys.stdin).get("guarded") or {}).values():
    for path in paths or []:
        print(path)
' | sort -u
}
RUN_CODE=(c scripts/c scripts/git-hooks eslint.prop-limits.json)
while IFS= read -r path; do RUN_CODE+=("$path"); done < <(
  guarded origin/main
  guarded "$HEAD_SHA"
  { git ls-tree -r --name-only origin/main; git ls-tree -r --name-only "$HEAD_SHA"; } | grep -E '(^|/)sgconfig\.ya?ml$' | sort -u
)
CHANGED_CODE="$(GIT_LITERAL_PATHSPECS=1 git diff --name-only origin/main "$HEAD_SHA" -- "${RUN_CODE[@]}" | grep -vE '^scripts/c/_lib/baselines/[^/]+\.txt$' || true)"
if [[ -n "$CHANGED_CODE" && "$TARGET" != pr ]]; then
  fail "PR #$PR changes code that ./c merge runs: $(tr '\n' ' ' <<<"$CHANGED_CODE")An Opus review reads it after the last push, and the orchestrator adds the rules-approved label. Then run ./c merge $PR again."
fi
main_still_in_head() {
  git fetch -q origin main
  git merge-base --is-ancestor origin/main "$HEAD_SHA" || fail "main moved during the review, so PR #$PR does not have the current main. Run ./c merge $PR again."
}
main_still_in_head
git worktree add -q -b "$CHECK_BRANCH" "$CHECK_DIR/head" "$HEAD_SHA"
CHECK_BRANCH_MADE=1
ln -s "$THC_ROOT/node_modules" "$CHECK_DIR/head/node_modules"
say "./c check structure on ${HEAD_SHA:0:9}"
(cd "$CHECK_DIR/head" && BASE_RULES_AGAINST=origin/main BASE_RULES_TARGET="$TARGET" ./c check structure) \
  || fail "The structure check failed on ${HEAD_SHA:0:9}. Fix it on the branch. For a loosened rule, an Opus review approves it after the last push, and the orchestrator adds the rules-approved label. Then run ./c merge $PR again."
cleanup
trap - EXIT

BRANCH="$(pr_field headRefName)"
CROSS_REPO="$(pr_field isCrossRepository)"
main_still_in_head
gh pr merge "$PR" --squash --match-head-commit "$HEAD_SHA" >/dev/null || fail "GitHub refused the merge of PR #$PR. Read gh pr view $PR, then run ./c merge $PR again."
if [[ "$CROSS_REPO" == "false" ]]; then
  RETARGETED=1
  for child in $(gh pr list --base "$BRANCH" --state open --limit 1000 --json number -q '.[].number'); do
    if gh pr edit "$child" --base main >/dev/null; then
      say "PR #$child now targets main."
      gh pr update-branch "$child" >/dev/null || say "GitHub could not merge main into PR #$child. Resolve the conflict on its branch and push."
    else
      RETARGETED=0
      say "GitHub could not move PR #$child to main. Move it to main, then delete the branch $BRANCH."
    fi
  done
  if (( RETARGETED == 1 )); then
    gh api -X DELETE "repos/{owner}/{repo}/git/refs/heads/$BRANCH" >/dev/null 2>&1 || true
  fi
fi
printf '✓ PR #%s merged (head %s, Greptile %s/5).\n' "$PR" "${HEAD_SHA:0:9}" "$SCORE"
