#!/usr/bin/env bash
#USAGE: status — which dev servers run, where, and for how long

set -euo pipefail

THC_ROOT="${THC_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
source "$THC_ROOT/scripts/c/_lib/services.sh"
source "$THC_ROOT/scripts/c/_lib/runtime.sh"

fmt="%-8s %-9s %-8s %-12s %s\n"
printf "$fmt" service state pid uptime url
for svc in "${KNOWN_SERVICES[@]}"; do
  pid="$(cat "$RUNTIME_DIR/pids/$svc.pid" 2>/dev/null || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    printf "$fmt" "$svc" running "$pid" "$(ps -o etime= -p "$pid" | tr -d ' ')" "$(service_url "$svc")"
  else
    printf "$fmt" "$svc" stopped -- -- --
  fi
done
check_runtime_dir "$THC_ROOT"
