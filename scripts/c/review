#!/usr/bin/env bash
#USAGE: review — post one Claude code-review of a PR head on the PR: ./c review <PR>

set -euo pipefail

cd "$THC_ROOT"

fail() { printf '✗ %s\n' "$1" >&2; exit 1; }

case "${1:-}" in
  ""|-h|--help)
    echo "Usage: ./c review <PR>"
    echo "  It runs one claude -p session with the built-in code-review skill on the PR head and posts the review on the PR."
    echo "  Start it in the background when the work of the PR is nearly done. Read it when it ends, fix the real findings once, then merge."
    [[ -n "${1:-}" ]] && exit 0
    exit 2
    ;;
esac

PR="$1"
command -v claude >/dev/null || fail "No claude CLI here. Install Claude Code, then run ./c review $PR again."
PR_FIELDS="$(gh pr view "$PR" --json headRefOid,baseRefName -q '"\(.headRefOid) \(.baseRefName)"')" \
  || fail "gh could not read PR #$PR. Check the PR number and gh auth status."
read -r HEAD_SHA BASE <<<"$PR_FIELDS"
git fetch -q origin "$BASE" "refs/pull/$PR/head" || fail "git could not fetch $BASE and the head of PR #$PR. Check the network, then run ./c review $PR again."
MERGE_BASE="$(git merge-base "origin/$BASE" "$HEAD_SHA")"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
git archive "$HEAD_SHA" | tar -x -C "$WORK"
find "$WORK" -type l -delete
git diff "$MERGE_BASE" "$HEAD_SHA" >"$WORK/PR.diff"

printf '→ One code-review session of PR #%s at %s.\n' "$PR" "${HEAD_SHA:0:9}"
(cd "$WORK" && claude -p "/code-review PR.diff" --model opus --no-session-persistence \
  --setting-sources "" --strict-mcp-config --permission-mode default \
  --allowedTools "Read(./**)" "Grep(./**)" "Glob(./**)" "Skill") >"$WORK/.review.md" \
  || fail "The review session did not finish. Run ./c review $PR again."

{ printf '## ./c review of %s\n\n' "${HEAD_SHA:0:9}"; cat "$WORK/.review.md"; } \
  | gh pr comment "$PR" --body-file - >/dev/null || fail "gh could not post the review on PR #$PR."
printf '✓ The review of %s is on PR #%s.\n' "${HEAD_SHA:0:9}" "$PR"
