{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hack-collective-work",
  "account_id": "191ce0f3febaf227407c1f816ab193e2",
  "main": "workers/internal/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "work.hackcollective.uk", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/version.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hack-collective-work",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "workers/internal/migrations"
    }
  ],
  "observability": { "enabled": true }
}
