{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@/ui/*": [
        "./src/components/ui/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@internal/*": [
        "./internal/*"
      ]
    },
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noImplicitReturns": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "internal/**/*.ts",
    "internal/**/*.tsx",
    "vite.config.ts",
    "cloudflare.config.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
