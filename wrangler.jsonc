{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "account_id": "191ce0f3febaf227407c1f816ab193e2",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "hackcollective.uk", "custom_domain": true },
    { "pattern": "www.hackcollective.uk", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "build": {
    "command": "bun run build",
    "watch_dir": "./src"
  }
}
